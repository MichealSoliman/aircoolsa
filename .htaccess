# ====================================================================
# Air Cool Jeddah - Server Configuration (.htaccess)
# ====================================================================

# 1. UTF-8 Default Encoding
AddDefaultCharset UTF-8

# 2. Custom 404 Error Document
ErrorDocument 404 /404.html

# 3. Enable Rewrite Engine & Canonical Redirects
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3.1 Enforce HTTPS (301)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3.2 Enforce non-www (301 canonical host)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 3.3 301 Redirect for Merged Page: /best-ac-company-jeddah/ -> /blog/choosing-ac-company-jeddah/
  RewriteRule ^best-ac-company-jeddah/?$ /blog/choosing-ac-company-jeddah/ [R=301,L]

  # 3.4 Enforce Trailing Slash on Directory/Section URLs (avoid duplicate URLs)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URLs: map /page to /page.html if exists
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Services subfolder clean URLs: /services/page to /services/page.html
  RewriteCond %{DOCUMENT_ROOT}/services/$1.html -f
  RewriteRule ^services/([^/]+)/?$ services/$1.html [L]

  # Blog subfolder clean URLs: /blog/page to /blog/page.html
  RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
  RewriteRule ^blog/([^/]+)/?$ blog/$1.html [L]
</IfModule>

# 4. GZIP / DEFLATE Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon font/woff2
</IfModule>

# 5. Browser Caching (Leverage Browser Caching)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images and icons (1 year)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts (1 year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # CSS and JavaScript (1 month with versioning recommended)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML (1 hour)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# 6. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
